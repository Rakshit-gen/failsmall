{
  "name": "failsmall",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply failsmall --local && wrangler dev",
    "deploy": "wrangler d1 migrations apply failsmall --remote && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
